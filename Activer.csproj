<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <StartupObject></StartupObject>
    <Version>1.2</Version>
    <AssemblyVersion>1.2</AssemblyVersion>
    <FileVersion>1.2</FileVersion>
    <Company>Eos Lolan</Company>
    <Authors>Eos Lolan</Authors>
    <Copyright>© 2025 Eos Lolan. Licensed under the MIT License.</Copyright>
    <ApplicationIcon>Resources\activer.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\activer.ico" />
    <None Remove="Resources\activer.png" />
    <None Remove="Resources\start.ico" />
    <None Remove="Resources\start.png" />
    <None Remove="Resources\stop.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Extended.Wpf.Toolkit" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Activer.Core\Activer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Activer.Core\**\*.cs" />
    <Compile Remove="Activer.Core.Tests\**\*" />
    <EmbeddedResource Remove="Activer.Core\**\*" />
    <EmbeddedResource Remove="Activer.Core.Tests\**\*" />
    <None Remove="Activer.Core\**\*" />
    <None Remove="Activer.Core.Tests\**\*" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\activer.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\activer.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\start.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\start.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\stop.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

</Project>
