<Window x:Class="Activer.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        Topmost="True">

    <Window.Resources>
        <SolidColorBrush x:Key="MenuSurfaceBrush" Color="#1F2228"/>
        <SolidColorBrush x:Key="MenuBorderBrush" Color="#343A44"/>
        <SolidColorBrush x:Key="MenuForegroundBrush" Color="#F5F7FA"/>
        <SolidColorBrush x:Key="MenuHoverBrush" Color="#2C313A"/>
        <SolidColorBrush x:Key="MenuPressedBrush" Color="#353B46"/>
        <SolidColorBrush x:Key="MenuDividerBrush" Color="#343943"/>

        <Style x:Key="TrayMenuButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="31"/>
            <Setter Property="Margin" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MenuForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource MenuPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#68707D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16"
            Background="{DynamicResource MenuSurfaceBrush}"
            BorderBrush="{DynamicResource MenuBorderBrush}"
            BorderThickness="1"
            Padding="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              ShadowDepth="6"
                              Direction="270"
                              Color="#000000"
                              Opacity="0.38"/>
        </Border.Effect>

        <StackPanel>
            <Button x:Name="ShowWindowButton"
                    Style="{StaticResource TrayMenuButtonStyle}"
                    Click="ShowWindowButton_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Width="12"
                          Height="12"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center">
                        <Rectangle Width="10"
                                   Height="8"
                                   RadiusX="2"
                                   RadiusY="2"
                                   Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   StrokeThickness="1.1"/>
                        <Rectangle Width="10"
                                   Height="2"
                                   Margin="0,1,0,0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Top"
                                   Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Grid>

                    <TextBlock Grid.Column="1"
                               Text="Show Window"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="12"/>
                </Grid>
            </Button>

            <Button x:Name="StartStopButton"
                    Style="{StaticResource TrayMenuButtonStyle}"
                    Click="StartStopButton_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Viewbox Width="12"
                             Height="12"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center">
                        <Path x:Name="StartStopIconPath"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Stretch="Uniform"/>
                    </Viewbox>

                    <TextBlock x:Name="StartStopTextBlock"
                               Grid.Column="1"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="12"/>
                </Grid>
            </Button>

            <Border Height="1"
                    Margin="8,5,8,5"
                    Background="{DynamicResource MenuDividerBrush}"/>

            <Button x:Name="QuitButton"
                    Style="{StaticResource TrayMenuButtonStyle}"
                    Click="QuitButton_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Viewbox Width="12"
                             Height="12"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center">
                        <Path Data="M3,3 L13,13 M13,3 L3,13"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Stretch="Uniform"/>
                    </Viewbox>

                    <TextBlock Grid.Column="1"
                               Text="Quit"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="12"/>
                </Grid>
            </Button>
        </StackPanel>
    </Border>
</Window>
